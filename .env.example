# Copie este arquivo para .env.local e ajuste os valores.
# NUNCA faça commit do .env.local.

# true = usa dados fictícios (não precisa do back-end rodando)
# false = chama a API real em API_URL
USE_MOCK_API=true

# URL base da API do back-end (usada quando USE_MOCK_API=false)
# Exemplo: http://localhost:8080
API_URL=